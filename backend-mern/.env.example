# Environnement
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Base de données PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/blog_mern?schema=public"

# JWT Secrets (GÉNÉREZ DES VALEURS SÉCURISÉES AVEC: openssl rand -base64 32)
JWT_SECRET=CHANGE_ME_WITH_SECURE_RANDOM_STRING
JWT_REFRESH_SECRET=CHANGE_ME_WITH_ANOTHER_SECURE_RANDOM_STRING
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# API Keys Salt (pour N8N et webhooks)
API_KEY_SALT=CHANGE_ME_WITH_SECURE_RANDOM_STRING

# CORS Origins (séparés par des virgules)
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# Upload
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logs
LOG_LEVEL=info

# N8N Integration
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=your-n8n-api-key-here

# Encryption for Credentials (AES-256)
ENCRYPTION_KEY=CHANGE_ME_WITH_32_CHAR_KEY_123456

# API Keys (optionnel - peut aussi être stocké en DB via /api/credentials)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
OPENAI_API_KEY=
STABILITY_API_KEY=
