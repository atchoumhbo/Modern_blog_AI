# Configuration Docker locale - DEVELOPMENT UNIQUEMENT
# Ce fichier utilise des ports différents pour ne pas interférer avec l'installation locale

# Environnement
NODE_ENV=development

# Serveur Strapi (port différent pour éviter les conflits)
HOST=0.0.0.0
PORT=1337

# Base de données PostgreSQL (nouveau container Docker)
DATABASE_CLIENT=postgres
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=blog_strapi_docker
DATABASE_USERNAME=strapi_docker
DATABASE_PASSWORD=docker_dev_password_2024

# Redis (nouveau container Docker)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=docker_redis_password_2024

# Strapi Secrets (DEV UNIQUEMENT - pas de secrets de production)
JWT_SECRET=docker_dev_jwt_secret_minimum_32_characters_long_for_development
ADMIN_JWT_SECRET=docker_dev_admin_jwt_secret_minimum_32_characters_for_dev
API_TOKEN_SALT=docker_dev_api_token_salt_minimum_32_characters_for_dev
TRANSFER_TOKEN_SALT=docker_dev_transfer_token_salt_minimum_32_characters
APP_KEYS=docker_dev_key1_minimum_32_chars,docker_dev_key2_minimum_32_chars,docker_dev_key3_minimum_32_chars,docker_dev_key4_minimum_32_chars

# Webhooks
WEBHOOKS_POPULATE_RELATIONS=false

# URLs (local Docker)
VITE_STRAPI_URL=http://localhost:1338
VITE_SITE_URL=http://localhost:3001
VITE_SITE_NAME=Modern Blog Leader - Docker Dev
VITE_API_URL=http://localhost:1338/api

# Pas de Google Analytics en dev
VITE_GA_MEASUREMENT_ID=

# Monitoring désactivé en dev
GRAFANA_USER=admin
GRAFANA_PASSWORD=docker_dev_grafana

# Email désactivé en dev