# Strapi Secrets - Docker Environment Variables
# Copier ce fichier vers .env et générer de nouvelles valeurs pour la production

# Pour générer des secrets sécurisés, utiliser :
# Linux/Mac: openssl rand -base64 32
# Windows PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))

# Application Keys (séparer par des virgules)
APP_KEYS=changeme1,changeme2

# API Token Salt
API_TOKEN_SALT=changeme

# Admin JWT Secret
ADMIN_JWT_SECRET=changeme

# Transfer Token Salt
TRANSFER_TOKEN_SALT=changeme

# JWT Secret
JWT_SECRET=changeme
