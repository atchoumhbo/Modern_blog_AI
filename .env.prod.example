# Production Environment Variables for VPS
# Copy this file to .env on your VPS and update the values

# === IMPORTANT SECURITY ===
# Generate strong random secrets for production!
# You can use: openssl rand -base64 32

# Strapi Secrets (CHANGE THESE!)
JWT_SECRET=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_32_CHARS_MINIMUM
ADMIN_JWT_SECRET=CHANGE_THIS_TO_ANOTHER_STRONG_RANDOM_SECRET_32_CHARS
API_TOKEN_SALT=CHANGE_THIS_TO_A_THIRD_STRONG_RANDOM_SECRET_32_CHARS
TRANSFER_TOKEN_SALT=CHANGE_THIS_TO_A_FOURTH_STRONG_RANDOM_SECRET_32
APP_KEYS=key1_32_chars_min,key2_32_chars_min,key3_32_chars_min,key4_32_chars_min

# Public URLs (CHANGE THESE!)
PUBLIC_URL=https://yourdomain.com
VITE_STRAPI_URL=https://yourdomain.com
VITE_API_URL=https://yourdomain.com/api
VITE_SITE_URL=https://yourdomain.com
VITE_SITE_NAME=Modern Blog Leader - Production

# Analytics (optional)
VITE_GA_MEASUREMENT_ID=

# Locales
VITE_LOCALES=fr,en
VITE_DEFAULT_LOCALE=fr

# Database (SQLite - no config needed)
# Data will be stored in Docker volume: strapi_prod_data
