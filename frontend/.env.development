# Environnement: Développement LOCAL (npm run dev)
# Frontend: http://localhost:5190
# Backend Strapi: http://localhost:1337

# URL Strapi pour le navigateur (client-side)
VITE_STRAPI_URL=http://localhost:1337

# URL Strapi pour le serveur SSR (server-side)  
# En dev local, le frontend tourne directement (pas Docker), donc on utilise localhost
VITE_STRAPI_URL_SERVER=http://localhost:1337

# URL publique du site frontend
VITE_SITE_URL=http://localhost:5190

# Configuration i18n
VITE_LOCALES=fr,en
VITE_DEFAULT_LOCALE=fr

# Google Analytics (optionnel)
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Twitter handle (optionnel)
# VITE_TWITTER_HANDLE=@yourblog
