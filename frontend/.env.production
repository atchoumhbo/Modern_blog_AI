# Configuration frontend - Production HTTPS
# Domaine: blog.bh-systems.be

# Backend type: 'strapi' ou 'mern'
VITE_BACKEND_TYPE=mern

# URL du backend MERN (via Nginx reverse proxy)
VITE_API_URL=https://blog.bh-systems.be/api
VITE_STRAPI_URL=https://blog.bh-systems.be

# Frontend URL
VITE_SITE_URL=https://blog.bh-systems.be

# Configuration i18n
VITE_LOCALES=fr,en
VITE_DEFAULT_LOCALE=fr

# Analytics (optionnel - à configurer plus tard)
# VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Twitter handle (À CONFIGURER)
# VITE_TWITTER_HANDLE=@yourblog
