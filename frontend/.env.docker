# Environnement: Docker LOCAL (docker-compose.dev.yml)
# Frontend: http://localhost:5173
# Backend Strapi: http://localhost:1339

# URL Strapi pour le navigateur (client-side)
# Le navigateur accède via localhost car les ports sont mappés
VITE_STRAPI_URL=http://localhost:1339

# URL Strapi pour le serveur SSR (server-side)
# Le container frontend utilise le nom du service Docker "strapi"
VITE_STRAPI_URL_SERVER=http://strapi:1337

# URL publique du site frontend
VITE_SITE_URL=http://localhost:5173

# Configuration i18n
VITE_LOCALES=fr,en
VITE_DEFAULT_LOCALE=fr

# Google Analytics (optionnel)
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Twitter handle (optionnel)
# VITE_TWITTER_HANDLE=@yourblog
