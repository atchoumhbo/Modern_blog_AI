# Multi-stage Dockerfile pour Strapi avec PostgreSQL
FROM node:18-alpine AS base

WORKDIR /opt/app

# Installer les dépendances système
RUN apk add --no-cache \
    python3 \
    make \
    g++ \
    gcc \
    libc-dev \
    postgresql-client \
    bash \
    && rm -rf /var/cache/apk/*

#######################################
# Stage 1: Builder
#######################################
FROM base AS builder

# Copier package.json et package-lock.json
COPY package*.json ./

# Installer toutes les dépendances (y compris dev)
# Utiliser npm install car package-lock.json peut ne pas exister
RUN npm install

# Copier le code source
COPY . .

# Build de l'admin panel et compilation TypeScript
ENV NODE_ENV=production
RUN npm run build

#######################################
# Stage 2: Production
#######################################
FROM base AS production

# Copier les node_modules depuis le builder
COPY --from=builder /opt/app/node_modules ./node_modules

# Copier le code source
COPY --from=builder /opt/app .

# Exposer le port Strapi
EXPOSE 1337

# Variables d'environnement par défaut (peuvent être overridées)
ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=1337

# Healthcheck pour vérifier que Strapi répond
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD node -e "require('http').get('http://localhost:1337/_health', (r) => {process.exit(r.statusCode === 200 ? 0 : 1)})"

# Démarrer Strapi
CMD ["npm", "run", "start"]
