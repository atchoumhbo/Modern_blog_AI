# Variables d'environnement pour la production
# Copiez ce fichier vers .env et configurez vos valeurs

# Base de données
DATABASE_NAME=blog_strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=your_secure_password_here

# Redis
REDIS_PASSWORD=your_redis_password_here

# Strapi Secrets (générez des valeurs aléatoirement sécurisées)
JWT_SECRET=your_jwt_secret_minimum_32_characters_long
ADMIN_JWT_SECRET=your_admin_jwt_secret_minimum_32_characters
API_TOKEN_SALT=your_api_token_salt_minimum_32_characters
APP_KEYS=key1_minimum_32_chars,key2_minimum_32_chars,key3_minimum_32_chars,key4_minimum_32_chars

# URLs
VITE_STRAPI_URL=https://api.votre-domaine.com
VITE_SITE_URL=https://votre-domaine.com
VITE_SITE_NAME=Modern Blog Leader

# Google Analytics
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Monitoring (optionnel)
GRAFANA_USER=admin
GRAFANA_PASSWORD=your_grafana_password

# Email (optionnel - configurez selon votre provider)
EMAIL_PROVIDER=smtp
EMAIL_PROVIDER_OPTIONS={"host":"smtp.gmail.com","port":587,"secure":false,"username":"your@email.com","password":"your_password"}

# SSL/TLS (si vous utilisez des certificats)
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/private.key